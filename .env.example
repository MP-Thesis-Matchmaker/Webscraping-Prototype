# Copy this file to .env and fill in what you need.
# .env is gitignored. Never commit real keys.
#
# Every variable is optional — the defaults below are what the code uses when
# nothing is set. All of them are declared in src/posting_scraper/config.py.

# --- LLM ---------------------------------------------------------------------
# Only needed to onboard a new source (spec drafting), to summarize process
# pages and thesis PDFs, and for the run-time extraction fallback. With no key
# the scraper is fully functional and purely deterministic — every LLM path
# degrades to its rule-based output instead of failing.
# OPENAI_API_KEY is accepted as-is; SCRAPER_LLM_API_KEY wins if both are set.
OPENAI_API_KEY=
SCRAPER_LLM_PROVIDER=openai
SCRAPER_LLM_MODEL=gpt-5-mini

# OpenAI-compatible gateway or local model. Leave empty for the OpenAI API.
# Examples: LibreChat / AI Buddy, or Ollama at http://localhost:11434/v1
SCRAPER_LLM_BASE_URL=

# Retry budget and hard timeout for one completion. Transient errors back off
# exponentially; auth failures are never retried.
SCRAPER_LLM_MAX_ATTEMPTS=3
SCRAPER_LLM_TIMEOUT_SECONDS=120

# Characters of page content sent to the model. Budgets, not page limits:
# anything past them is dropped.
SCRAPER_LLM_PAGE_TEXT_BUDGET=6000
SCRAPER_LLM_FALLBACK_HTML_BUDGET=14000
SCRAPER_SPEC_DRAFT_HTML_BUDGET=16000

# --- Data tree ---------------------------------------------------------------
# Root of everything the scraper reads or writes: registry/, contracts/, cache/,
# output/, var/. Defaults to the repo checkout. Point it elsewhere to run the
# tool against another data tree without touching the code.
SCRAPER_DATA_ROOT=

# --- Politeness --------------------------------------------------------------
# Address advertised in the User-Agent so a site owner can reach a human.
SCRAPER_CONTACT=nicolas.o.peyer@gmail.com

# Seconds between requests. Lower it only with a reason.
SCRAPER_POLITE_DELAY_SECONDS=2.0

# Hard per-request timeout (also the page.goto timeout for the renderer).
SCRAPER_HTTP_TIMEOUT_SECONDS=30

# Playwright render waits. Some UZH pages never reach network-idle, so the idle
# wait is bounded and the settle gives client-side JS time to paint.
SCRAPER_RENDER_IDLE_MS=6000
SCRAPER_RENDER_SETTLE_MS=700

# --- Cache and onboarding ----------------------------------------------------
# Previous page versions kept under cache/<source_id>/history/.
SCRAPER_CACHE_HISTORY_KEEP=3

# Default for `onboard --profile-limit` (person profiles followed).
SCRAPER_PROFILE_LIMIT=3

# Note: the title-plausibility thresholds in title_check.py are deliberately
# NOT configurable. They are calibrated against tests/golden_contracts.json,
# and an environment variable that moved them would change stored data and
# break the "same cached page + same template => identical records" invariant.
